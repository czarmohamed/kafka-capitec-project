{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "digitalpayments.notification.events.v1",
  "title": "Notification event",
  "description": "Outcome of a customer notification for one payment. Published to digitalpayments.notification.events.v1, keyed by customerId.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "schemaVersion",
    "eventTime",
    "sourceEventId",
    "paymentId",
    "customerId",
    "notificationType",
    "channel",
    "deliveryStatus",
    "attempts"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "sourceEventId": {
      "type": "string",
      "format": "uuid",
      "description": "eventId of the lifecycle event that triggered the notification."
    },
    "paymentId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "pattern": "^CUST-[0-9]{8}$"
    },
    "notificationType": {
      "enum": ["PAYMENT_APPROVED", "PAYMENT_FAILED"]
    },
    "channel": {
      "enum": ["SMS", "PUSH"]
    },
    "deliveryStatus": {
      "enum": ["SENT", "FAILED"]
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}
